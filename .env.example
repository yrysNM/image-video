# SQLite database (relative to prisma/ directory)
DATABASE_URL="file:./dev.db"

# Video provider: runway | fal | kling | mock
VIDEO_API_PROVIDER=runway
VIDEO_API_KEY=

# Public base URL of this app
NEXT_PUBLIC_APP_URL=http://localhost:9090

# Optional S3-compatible storage for production
STORAGE_BUCKET_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
